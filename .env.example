APP_ENV=local
APP_VERSION=dev
API_HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:54322/postgres
DATABASE_POOL_MAX=10
DATABASE_MIGRATION_CONFIRM=
DATABASE_BACKUP_CONFIRMED=false
DATABASE_ROLLBACK_PLAN_CONFIRMED=false

PG_BOSS_SCHEMA=pgboss
PG_BOSS_MIGRATE=false
OUTBOX_BATCH_SIZE=50
OUTBOX_LOCK_LEASE_SECONDS=60
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_POLL_INTERVAL_MS=1000
WORKER_HEARTBEAT_INTERVAL_MS=10000
HEALTH_WORKER_HEARTBEAT_DEGRADED_SECONDS=30
HEALTH_WORKER_HEARTBEAT_FAILED_SECONDS=60
HEALTH_OUTBOX_LAG_DEGRADED_SECONDS=60
HEALTH_OUTBOX_LAG_FAILED_SECONDS=300

ADMIN_AUTH_ENABLED=false
ADMIN_AUTH_ISSUER=
ADMIN_AUTH_AUDIENCE=authenticated
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
OFFER_STORAGE_ENABLED=false
OFFER_STORAGE_SUPABASE_URL=
OFFER_STORAGE_SERVICE_ROLE_KEY=
OFFER_STORAGE_BUCKET=offer-snapshots
ADMIN_API_BASE_URL=http://localhost:3000
ORDER_TOKEN_SECRET=replace-with-at-least-32-url-safe-characters
ORDER_NUMBER_PREFIX=BP
ORDER_EXPIRY_BATCH_SIZE=50
ORDER_EXPIRY_POLL_INTERVAL_MS=5000
TELEGRAM_NOTIFICATIONS_ENABLED=false
ADMIN_NOTIFICATION_TELEGRAM_CHAT_ID=
NOTIFICATION_DELIVERY_LEASE_SECONDS=60
NOTIFICATION_WORKER_CONCURRENCY=2
BROADCAST_MESSAGES_PER_SECOND=20
ADMIN_BOOTSTRAP_CONFIRM=
ADMIN_BOOTSTRAP_AUTH_SUBJECT=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_DISPLAY_NAME=
ADMIN_BOOTSTRAP_REASON=

TELEGRAM_BOT_TOKEN=
# Optional: base URL of a reverse proxy in front of api.telegram.org (e.g. a
# Cloudflare Worker), for environments where Telegram's API is blocked directly.
# Leave empty to talk to api.telegram.org as usual. No trailing slash.
TELEGRAM_API_ROOT=
TELEGRAM_DELIVERY_MODE=long-polling
TELEGRAM_DEFAULT_COUNTRY=RU
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH_SECRET=
TELEGRAM_WEBHOOK_BODY_LIMIT_BYTES=262144
TELEGRAM_WEBHOOK_BASE_URL=

TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_PAYMENTS_ENABLED=false
TBANK_API_BASE_URL=https://rest-api-test.tinkoff.ru/v2
TBANK_NOTIFICATION_URL=
TBANK_SUCCESS_URL=
TBANK_FAIL_URL=
TBANK_PAY_TYPE=O
TBANK_HTTP_TIMEOUT_MS=8000
TBANK_WEBHOOK_BODY_LIMIT_BYTES=65536
TBANK_RECONCILIATION_ENABLED=false
TBANK_RECONCILIATION_BATCH_SIZE=10
TBANK_RECONCILIATION_LEASE_SECONDS=120
TBANK_RECONCILIATION_POLL_INTERVAL_MS=15000
TBANK_RECONCILIATION_INITIAL_DELAY_SECONDS=60
TBANK_RECONCILIATION_RETRY_BASE_SECONDS=30
TBANK_RECONCILIATION_RETRY_MAX_SECONDS=3600
TBANK_RECONCILIATION_EMPTY_THRESHOLD=3

# База MAX-бота — только для переноса данных (packages/database/scripts/max-import.ts).
# В обычной работе не нужна и в .env на сервере лежать не должна: скрипт запускают руками,
# один раз, передав строку подключения в самой команде.
MAX_DATABASE_URL=
# TLS до базы MAX: require (по умолчанию) — как у самого бота, disable — локальная копия.
MAX_DATABASE_SSL=require

# Канал MAX внутри общего api.
#
# Пусто — канал не поднимается, и MAX продолжает работать отдельным приложением на своей
# базе. Включать только вместе с отключением старого бота: два приёмника на одни обновления
# означают двух собеседников у одного человека.
#
# MAX_WEBHOOK_PATH_SECRET — наш секрет в адресе (не меньше 16 знаков): openssl rand -hex 24
# MAX_WEBHOOK_SECRET — секрет, который MAX присылает заголовком; задаётся при подписке.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_WEBHOOK_PATH_SECRET=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_BODY_LIMIT_BYTES=262144
MAX_HTTP_TIMEOUT_MS=10000

# Звонобот: обратная связь с автообзвона.
#
# Пусто — приёмник не поднимается вовсе, и путь отвечает 404. Ключ — длинная случайная
# строка (не меньше 16 знаков): он стоит в адресе вебхука, поэтому адрес целиком является
# секретом. Сгенерировать: openssl rand -hex 24
ZVONOBOT_WEBHOOK_SECRET=
ZVONOBOT_BODY_LIMIT_BYTES=65536
ZVONOBOT_BATCH_SIZE=100
ZVONOBOT_POLL_INTERVAL_MS=60000

DEFAULT_OFFER_SOURCE_URL=https://docs.google.com/document/d/1rNFUhIlL2ZNp8dY9gOdycmYYXmlP3iJZpA7laW9HMBI/edit?tab=t.0

ADMIN_APP_URL=http://localhost:3000
SENTRY_DSN=
ENCRYPTION_KEY=
