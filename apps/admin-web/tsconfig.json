{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2023"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@ticket-platform/contracts": [
        "../../packages/contracts/src/admin-operations.ts"
      ],
      "@ticket-platform/contracts/admin-events": [
        "../../packages/contracts/src/admin-events.ts"
      ],
      "@ticket-platform/contracts/admin-outreach": [
        "../../packages/contracts/src/admin-outreach.ts"
      ],
      "@ticket-platform/contracts/admin-accommodation": [
        "../../packages/contracts/src/admin-accommodation.ts"
      ],
      "@ticket-platform/contracts/admin-participants": [
        "../../packages/contracts/src/admin-participants.ts"
      ],
      "@ticket-platform/contracts/admin-expenses": [
        "../../packages/contracts/src/admin-expenses.ts"
      ],
      "@ticket-platform/contracts/admin-inventory": [
        "../../packages/contracts/src/admin-inventory.ts"
      ],
      "@ticket-platform/contracts/admin-organizers": [
        "../../packages/contracts/src/admin-organizers.ts"
      ],
      "@ticket-platform/contracts/admin-overview": [
        "../../packages/contracts/src/admin-overview.ts"
      ],
      "@ticket-platform/contracts/admin-event-report": [
        "../../packages/contracts/src/admin-event-report.ts"
      ],
      "@ticket-platform/contracts/site-registration": [
        "../../packages/contracts/src/site-registration.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
