# =============================================================================
# Готовый шаблон .env для запуска продаж билетов через Telegram-бота.
# Скопируйте этот файл в ".env" на сервере и заполните поля с пометкой "ЗАПОЛНИТЬ".
# Всё остальное можно оставить как есть — это уже безопасные значения для старта.
#
# Этот файл используется ТРЕМЯ процессами, которые нужно запустить на сервере:
#   1) apps/telegram-bot — сам бот (меню, выбор билета, кнопка "Оплатить")
#   2) apps/api          — принимает подтверждения оплаты от Т-Банка
#   3) apps/worker        — фоновые задачи (доставляет билет после оплаты,
#                           снимает бронь, если человек передумал)
# Все три должны быть запущены одновременно и смотреть в одну и ту же базу данных.
#
# ВАЖНО про APP_ENV: начинаем с "staging" (тестовый режим) — так можно проверить
# всю цепочку покупки без реальных денег, включая тестовый адрес Т-Банка ниже.
# Когда пройдёте Шаг 8 инструкции и убедитесь, что билет доходит — меняете ДВЕ
# строки (см. TBANK_API_BASE_URL ниже и APP_ENV) на боевые, это Шаг 9.
# =============================================================================

APP_ENV=staging
APP_VERSION=1.0.0
API_HOST=0.0.0.0
PORT=3000

# --- База данных -------------------------------------------------------------
# ЗАПОЛНИТЬ: строка подключения к вашему Postgres на Timeweb.
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БАЗЫ
# Обычно DATABASE_URL и DATABASE_DIRECT_URL совпадают, если у вас нет отдельного
# "пулера" соединений (Timeweb обычно даёт один и тот же адрес для обоих).
DATABASE_URL=ЗАПОЛНИТЬ
DATABASE_DIRECT_URL=ЗАПОЛНИТЬ
DATABASE_POOL_MAX=10

# Эти три строки нужны только когда APP_ENV=production (Шаг 9) и только в момент
# запуска миграций. Пока APP_ENV=staging они ни на что не влияют — не трогайте.
DATABASE_MIGRATION_CONFIRM=apply-production-migrations
DATABASE_BACKUP_CONFIRMED=true
DATABASE_ROLLBACK_PLAN_CONFIRMED=true

PG_BOSS_SCHEMA=pgboss
PG_BOSS_MIGRATE=false
OUTBOX_BATCH_SIZE=50
OUTBOX_LOCK_LEASE_SECONDS=60
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_POLL_INTERVAL_MS=1000
WORKER_HEARTBEAT_INTERVAL_MS=10000
HEALTH_WORKER_HEARTBEAT_DEGRADED_SECONDS=30
HEALTH_WORKER_HEARTBEAT_FAILED_SECONDS=60
HEALTH_OUTBOX_LAG_DEGRADED_SECONDS=60
HEALTH_OUTBOX_LAG_FAILED_SECONDS=300

# --- Админ-панель и оферта -----------------------------------------------------
# Порядок настройки панели — в ЗАПУСК_АДМИНКИ.md. Вход в панель работает через
# Supabase Auth: там только почта, пароль и второй фактор, данные остаются в
# нашей базе. Загрузка оферты в облако — отдельная история, к панели отношения
# не имеет, и на старте продаж не нужна.
ADMIN_AUTH_ENABLED=false
# Адрес проекта Supabase ОБЯЗАТЕЛЬНО с хвостом /auth/v1 — по нему API забирает
# публичные ключи и сверяет издателя токена.
ADMIN_AUTH_ISSUER=
ADMIN_AUTH_AUDIENCE=authenticated
# А эти два — тот же адрес БЕЗ /auth/v1 и публикуемый (publishable) ключ.
# Внимание: они вшиваются в сборку панели, а не читаются при запуске, поэтому
# после их изменения панель надо пересобрать, перезапуска мало.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Второй фактор при входе в панель. Выключение снимает и требование у ролей,
# помеченных requires_mfa, и защиту денежных действий — подтверждения оплаты,
# возврата, правки кошелька: их станет достаточно защищать паролем. Механика
# входа по коду при этом остаётся на месте и включается обратно этими же двумя
# переменными. Переменных две, и значение у них должно быть одно: первую читает
# api при запуске, вторую панель вшивает в сборку — после её изменения панель
# надо пересобрать, перезапуска мало.
ADMIN_MFA_REQUIRED=false
NEXT_PUBLIC_ADMIN_MFA_REQUIRED=false
OFFER_STORAGE_ENABLED=false
OFFER_STORAGE_SUPABASE_URL=
OFFER_STORAGE_SERVICE_ROLE_KEY=
OFFER_STORAGE_BUCKET=offer-snapshots
# Адрес API изнутри сервера. Именно 127.0.0.1, а не localhost: API слушает
# только IPv4, а localhost на Node может сначала уйти в IPv6 и получить отказ.
ADMIN_API_BASE_URL=http://127.0.0.1:3001
# Заполняются только на время создания первого администратора, после чего
# удаляются из файла — скрипт всё равно срабатывает единственный раз.
ADMIN_BOOTSTRAP_CONFIRM=
ADMIN_BOOTSTRAP_AUTH_SUBJECT=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_DISPLAY_NAME=
ADMIN_BOOTSTRAP_REASON=

# --- Секреты заказов и билетов -------------------------------------------------
# Уже сгенерированы случайно, менять не нужно. Главное — использовать ОДНО И ТО
# ЖЕ значение во всех трёх процессах (просто используйте один и тот же файл .env).
ORDER_TOKEN_SECRET=r3jt3ps7BcHXgNHAQGbmNWFvKp1cichDNSvJy7QW_zjGEdev
ORDER_NUMBER_PREFIX=BP
ORDER_EXPIRY_BATCH_SIZE=50
ORDER_EXPIRY_POLL_INTERVAL_MS=5000

# --- Уведомления в Telegram (доставка билета, чек оплаты) ----------------------
# ВКЛЮЧЕНО: без этого worker не сможет прислать человеку билет после оплаты.
TELEGRAM_NOTIFICATIONS_ENABLED=true
# ЗАПОЛНИТЬ: ваш личный Telegram chat_id (или id рабочего чата), куда бот будет
# слать уведомления о новых покупках. Можно указать несколько через запятую
# (например: 111111111,222222222). Как узнать — см. инструкцию, шаг 6.
ADMIN_NOTIFICATION_TELEGRAM_CHAT_ID=ЗАПОЛНИТЬ
NOTIFICATION_DELIVERY_LEASE_SECONDS=60
NOTIFICATION_WORKER_CONCURRENCY=2

# Напоминания за 10/7/3/1 день до события и анкета после оплаты — намеренно
# ОТКЛЮЧЕНЫ на этом этапе (мы договорились запускать только "посмотреть программу
# + купить билет"). Их можно включить позже отдельным шагом, без переустановки.
EVENT_REMINDER_BATCH_SIZE=50
EVENT_REMINDER_POLL_INTERVAL_MS=300000

# Наполнение кампаний обзвона участниками мероприятий. Кампания заводится вместе с
# мероприятием, а этот проход складывает в неё тех, кто записался: заявкой с сайта,
# оплаченным заказом или рукой администратора. Минута — чтобы заведённый вручную
# участник появлялся в обзвоне почти сразу. Проход дешёвый: кампании, где список
# участников не менялся, отсекаются одним запросом.
EVENT_CAMPAIGN_SYNC_BATCH_SIZE=20
EVENT_CAMPAIGN_SYNC_POLL_INTERVAL_MS=60000

# --- Сам бот -------------------------------------------------------------------
# ЗАПОЛНИТЬ: токен бота, который вам уже выдал @BotFather.
TELEGRAM_BOT_TOKEN=ЗАПОЛНИТЬ
# Необязательно: если сервер в России и api.telegram.org заблокирован напрямую —
# укажите адрес своего прокси (например, Cloudflare Worker) без слэша на конце.
# Если оставить пустым — бот стучится в api.telegram.org напрямую.
TELEGRAM_API_ROOT=
# long-polling = бот сам спрашивает Telegram "что нового", не требует домена и
# HTTPS. Самый простой и надёжный вариант для старта.
TELEGRAM_DELIVERY_MODE=long-polling
TELEGRAM_DEFAULT_COUNTRY=RU
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=7Q-3LoPZ_IZ7kI1HLq7xYryUijKDfsSDpYKld6epuNcgjxYS
TELEGRAM_WEBHOOK_PATH_SECRET=qxkfssOdIrOhkaLYMLzpRA5eIfKgiiIE3FL2VwfcQG81oEIA
TELEGRAM_WEBHOOK_BODY_LIMIT_BYTES=262144
TELEGRAM_WEBHOOK_BASE_URL=

# --- Приём оплаты через Т-Банк --------------------------------------------------
# ЗАПОЛНИТЬ после получения данных от Т-Банка (см. инструкцию, шаг 1).
TBANK_TERMINAL_KEY=ЗАПОЛНИТЬ
TBANK_PASSWORD=ЗАПОЛНИТЬ
TBANK_PAYMENTS_ENABLED=true
# Тестовый адрес — работает, пока APP_ENV=staging (см. вверху файла). Когда Т-Банк
# подтвердит боевой терминал, меняете ОБЕ строки разом: APP_ENV=production выше
# и этот адрес на https://securepay.tinkoff.ru/v2 (см. инструкцию, Шаг 9). Заменить
# только одну из двух строк код не даст запуститься — это защита от случайной
# боевой оплаты через тестовый адрес и наоборот.
TBANK_API_BASE_URL=https://rest-api-test.tinkoff.ru/v2
# ЗАПОЛНИТЬ: публичный адрес вашего сервера (домен с https://), см. инструкцию.
# Пример: https://bot.ваш-домен.ru/webhooks/payments/tbank
TBANK_NOTIFICATION_URL=ЗАПОЛНИТЬ
# Куда вернуть человека в браузере после оплаты — можно временно указать сюда же
# ссылку на бота: https://t.me/ИМЯ_ВАШЕГО_БОТА
TBANK_SUCCESS_URL=ЗАПОЛНИТЬ
TBANK_FAIL_URL=ЗАПОЛНИТЬ
TBANK_PAY_TYPE=O
TBANK_HTTP_TIMEOUT_MS=8000
TBANK_WEBHOOK_BODY_LIMIT_BYTES=65536
# Сверку платежей включим позже, не блокирует запуск продаж.
TBANK_RECONCILIATION_ENABLED=false
TBANK_RECONCILIATION_BATCH_SIZE=10
TBANK_RECONCILIATION_LEASE_SECONDS=120
TBANK_RECONCILIATION_POLL_INTERVAL_MS=15000
TBANK_RECONCILIATION_INITIAL_DELAY_SECONDS=60
TBANK_RECONCILIATION_RETRY_BASE_SECONDS=30
TBANK_RECONCILIATION_RETRY_MAX_SECONDS=3600
TBANK_RECONCILIATION_EMPTY_THRESHOLD=3

DEFAULT_OFFER_SOURCE_URL=https://docs.google.com/document/d/1rNFUhIlL2ZNp8dY9gOdycmYYXmlP3iJZpA7laW9HMBI/edit?tab=t.0

ADMIN_APP_URL=https://admin.biz-day.ru
SENTRY_DSN=
ENCRYPTION_KEY=
